          "duplicate_subjects",
          "base_members",
          "archivist_proposals"
        ],
        "Activity MCP": [
          "record_history",
          "recent_activity"
        ],
        "Actions MCP": [
          "archivist_propose",
          "notification"
        ]
      },
      "skills": [
        "skills/knowledge-basics",
        "skills/reading-the-graph",
        "skills/monday-base-report",
        "skills/merge-duplicate-subjects"
      ]
    }
  ],
  "approvals": [
